HOST=0.0.0.0
PORT=3001
POLL_INTERVAL_MS=5000
TSE_RESULTS_URL=https://resultados.tse.jus.br/oficial/ele2026/6258/dados/br/br-c0001-e006258-u.json
DATA_FILE=data/snapshots.jsonl
HISTORY_MEMORY_LIMIT=5000
HISTORY_RESPONSE_LIMIT=200
STATIC_DIR=../frontend/dist

# Use 1 somente quando a aplicação estiver atrás de um proxy reverso confiável.
TRUST_PROXY=0
CORS_ORIGIN=*
PUBLIC_SITE_URL=https://seu-dominio.com.br

# Limites conservadores: um usuário normal abre 2 requisições e mantém 1 SSE.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
HISTORY_RATE_LIMIT_MAX_REQUESTS=60
MAX_SSE_CLIENTS=2000
MAX_SSE_CLIENTS_PER_IP=250
MAX_TSE_RESPONSE_BYTES=5000000
